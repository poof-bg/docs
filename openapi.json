    "/jobs/{id}": {
      "get": {
        "operationId": "getJob",
        "summary": "Get Job",
        "description": "Returns the current state of a job created by POST /remove for a video: status (queued, processing, completed or failed), progress from 0 to 1, and once completed the result_url (a direct CDN link that needs no API key) and expires_at (24 hours after completion, after which the result is deleted). Free; GET requests under /jobs/ are exempt from the per-organisation rate limit. Poll every 2 to 5 seconds.",
        "tags": ["Background Removal"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Job ID returned by POST /remove for a video (starts with job_).",
            "schema": {
              "type": "string",
              "example": "job_8f3a1c2e9b7d4a10"
            }
          }
        ],
        "responses": {
