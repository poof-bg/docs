                  "request_id": "req_3f6a2c1e-9b0d-4e7a-8c21-5d1f0a9b7e42",
                  "doc_url": "https://docs.poof.bg/errors/upstream-error"
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "operationId": "getMe",
        "summary": "Get Account Info",
        "description": "Returns information about the authenticated account including plan details and credit usage. This endpoint is free: it does not consume credits and is not rate limited.",
        "tags": ["Account"],
        "responses": {
          "200": {
            "description": "Account information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountInfo"
                },
                "example": {
                  "organizationId": "org_abc123",
                  "plan": "Pro",
                  "maxCredits": 2000,
                  "usedCredits": 1234,
                  "autoRechargeThreshold": 0.9
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "headers": {
              "X-Request-ID": {
                "description": "Unique request identifier, equal to request_id in the body. Include it when contacting support.",
                "schema": {
                  "type": "string",
                  "example": "req_3f6a2c1e-9b0d-4e7a-8c21-5d1f0a9b7e42"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "authentication_error",
                  "message": "API key missing or not recognised. Send it in the 'x-api-key' header.",
                  "request_id": "req_3f6a2c1e-9b0d-4e7a-8c21-5d1f0a9b7e42",
                  "doc_url": "https://docs.poof.bg/errors/authentication-error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Your API key. Get one at https://dash.poof.bg"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "description": "Error body returned by every non-2xx response. The X-Request-ID response header equals request_id.",
        "required": ["code", "message", "request_id"],
        "properties": {
          "code": {
            "type": "string",
            "description": "Machine-readable error code",
            "enum": [
              "authentication_error",
              "permission_denied",
              "payment_required",
              "rate_limit_exceeded",
              "validation_error",
              "missing_image",
              "image_too_large",
              "invalid_image",
              "processing_failed",
              "upstream_error",
              "internal_server_error",
              "not_found",
              "video_too_large",
              "video_too_long",
              "invalid_video",
              "job_not_found"
            ]
          },
          "message": {
            "type": "string",
            "description": "Human-readable error message"
          },
          "details": {
            "description": "Optional additional context. For validation_error this is an object mapping field names to a list of messages.",
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": true
              },
              {
                "type": "string"
              }
            ]
          },
          "request_id": {
            "type": "string",
            "description": "Unique request ID for support (also sent as the X-Request-ID header)",
            "example": "req_3f6a2c1e-9b0d-4e7a-8c21-5d1f0a9b7e42"
          },
          "doc_url": {
            "type": "string",
            "format": "uri",
            "description": "Link to the documentation page for this error code",
            "example": "https://docs.poof.bg/errors/validation-error"
          }
        }
      },
      "AccountInfo": {
        "type": "object",
        "properties": {
          "organizationId": {
            "type": "string",
            "description": "Your organization ID"
          },
          "plan": {
            "type": "string",
            "description": "Current plan display name (e.g. \"Free\", \"Pro\")",
            "example": "Pro"
          },
          "maxCredits": {
            "type": "integer",
            "description": "Total credits available in billing cycle",
            "example": 2000
          },
          "usedCredits": {
            "type": "integer",
            "description": "Credits used in current billing cycle",
            "example": 1234
          },
          "autoRechargeThreshold": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 0.95,
            "description": "Fraction of the plan limit at which Auto Recharge triggers (e.g. 0.9 = 90%). Omitted when Auto Recharge is off.",
            "example": 0.9
          }
        },
        "required": ["organizationId", "plan", "maxCredits", "usedCredits"]
      },
      "Job": {
        "type": "object",
        "description": "A video background removal job, as returned with 202 by POST /remove and by GET /jobs/{id}.",
        "required": [
          "id",
          "status",
          "progress",
          "created_at",
          "started_at",
          "completed_at",
          "duration_seconds",
          "fps",
          "width",
          "height",
          "frames",
          "credits",
          "format",
          "channels",
          "status_url",
          "result_url",
          "expires_at",
          "error",
          "stats"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Job ID, prefixed with job_",
            "example": "job_8f3a1c2e9b7d4a10"
          },
          "status": {
            "type": "string",
            "enum": ["queued", "processing", "completed", "failed"],
            "description": "Job state. queued and processing are transient; completed and failed are terminal.",
            "example": "processing"
          },
          "progress": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Fraction of the video processed so far, 0 to 1",
            "example": 0.42
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the job was accepted",
            "example": "2026-10-12T10:12:00Z"
          },
          "started_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "When processing began; null while queued",
            "example": "2026-10-12T10:12:04Z"
          },
          "completed_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "When the job reached completed or failed; null until then",
            "example": null
          },
          "duration_seconds": {
            "type": "number",
            "description": "Source video duration in seconds",
            "example": 12.4
          },
          "fps": {
            "type": "number",
            "description": "Source frame rate",
            "example": 29.97
          },
          "width": {
            "type": "integer",
            "description": "Source video width in pixels",
            "example": 1920
          },
          "height": {
            "type": "integer",
            "description": "Source video height in pixels",
            "example": 1080
          },
          "frames": {
            "type": "integer",
            "description": "Number of frames in the source video",
            "example": 372
          },
          "credits": {
            "type": "integer",
            "description": "Credits charged for this job (5 per second of source video, rounded up; 10 per second above 30 fps). Refunded automatically if the job fails.",
            "example": 65
          },
          "format": {
            "type": "string",
            "enum": ["webm", "mov", "mp4"],
            "description": "Requested output format",
            "example": "webm"
          },
          "channels": {
            "type": "string",
            "enum": ["rgba", "rgb", "alpha"],
            "description": "Requested output channels",
            "example": "rgba"
          },
          "status_url": {
            "type": "string",
            "format": "uri",
            "description": "URL of the job; GET it to poll for progress",
            "example": "https://api.poof.bg/v1/jobs/job_8f3a1c2e9b7d4a10"
          },
          "result_url": {
            "type": ["string", "null"],
            "format": "uri",
            "description": "Direct download URL of the result on the Poof CDN (https://cdn.poof.bg/...). Needs no API key; anyone with the link can download the file until expires_at. Served with Content-Disposition: attachment; filename=result.<ext>. Null until the job is completed.",
            "example": null
          },
          "expires_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "When the result is deleted, 24 hours after completion; null until the job is completed. After this time result_url stops working and the job returns 404 job_not_found.",
            "example": null
          },
          "error": {
            "type": ["object", "null"],
            "description": "Set when status is failed, null otherwise",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string",
                "description": "Machine-readable error code",
                "example": "processing_failed"
              },
              "message": {
                "type": "string",
                "description": "Human-readable description of the failure",
                "example": "The model or encoder failed on this video."
              }
            },
            "example": null
          },
          "stats": {
            "type": ["object", "null"],
            "additionalProperties": true,
            "description": "Processing statistics, set once the job is completed and null otherwise. output_width, output_height and processing_seconds are guaranteed (the output is capped at 1920 px on the longest side, or smaller with size; width and height above are the source dimensions). Other keys are informational and may change.",
            "properties": {
              "output_width": {
                "type": "integer",
                "description": "Output width in pixels",
                "example": 1920
              },
              "output_height": {
                "type": "integer",
                "description": "Output height in pixels",
                "example": 1080
              },
              "processing_seconds": {
                "type": "number",
                "description": "Wall-clock processing time, from started_at to completed_at",
                "example": 37.2
              }
            },
            "example": null
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Background Removal",
      "description": "Background removal for images and video, and the jobs that video processing creates"
    },
    {
      "name": "Account",
      "description": "Account and billing information"
    }
  ],
  "externalDocs": {
    "description": "Poof API Documentation",
    "url": "https://docs.poof.bg"
  }
}
