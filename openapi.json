{
  "openapi": "3.1.0",
  "info": {
    "title": "Poof API",
    "description": "The developer-first standard for background removal. Precise, fast, and scalable.",
    "version": "1.0.0",
    "contact": {
      "name": "Poof Support",
      "email": "support@poof.bg",
      "url": "https://poof.bg"
    },
    "license": {
      "name": "Proprietary",
      "url": "https://poof.bg/terms"
    }
  },
  "servers": [
    {
      "url": "https://api.poof.bg/v1",
      "description": "Production API"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/remove": {
      "post": {
        "operationId": "removeBackground",
        "summary": "Remove Background",
        "description": "Remove the background from an image or a video. The media type is detected from the file content, never from the field name or extension. Images are processed synchronously and returned directly in the response body (200); each successful image request costs 1 credit regardless of parameters. Videos are accepted with 202 and processed in the background: poll GET /jobs/{id} every 2 to 5 seconds and download the job's result_url (a direct CDN link, valid for 24 hours) once it is completed. Video costs 5 credits per second of source video, rounded up (10 per second above 30 fps), charged on acceptance and refunded automatically if the job fails. Video limits: 5 minutes, 100 MB upload or 500 MB via url, output capped at 1080p, audio preserved except with channels=alpha. GIF and animated WebP files are handled by the image path, so a GIF is still rejected (invalid_image) and an animated WebP uses its first frame; neither is treated as a video. Failed and rejected requests are not billed.",
        "tags": ["Background Removal"],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "The image or video to process. Images: JPEG, PNG or WebP, max 20MB. Videos: MP4, MOV, WebM, M4V or MKV, max 100MB (use url for larger files). Required unless url is given. The legacy names image_file and image_file_b64 are accepted as aliases."
                  },
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "example": "https://example.com/photos/product.jpg",
                    "description": "Public https URL of the image or video to process; Poof downloads it server-side (images max 20MB, videos max 500MB, up to 3 redirects, 15s timeout). URLs pointing at private, loopback or link-local addresses are rejected. Required unless file is given. The legacy name image_url is accepted as an alias."
                  },
                  "image_file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Legacy alias for file. Behaves exactly like file, for images and videos alike."
                  },
                  "image_file_b64": {
                    "type": "string",
                    "format": "byte",
                    "description": "Legacy alias: the image as a base64 string, with or without a data:<mime>;base64, prefix. Max 20MB decoded. Images only."
                  },
                  "image_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Legacy alias for url. Behaves exactly like url."
                  },
                  "format": {
                    "type": "string",
                    "enum": ["png", "jpg", "webp", "webm", "mov", "mp4"],
                    "description": "Output format. Images: png (default), jpg or webp; for remove.bg compatibility, auto is accepted and treated as png, zip is not supported. Videos: webm (default, VP9, transparent with channels=rgba), mov (ProRes, transparent with channels=rgba) or mp4 (H.264, never transparent: the subject is composited on bg_color). A format from the wrong family for the media is rejected with 400 validation_error listing the valid values."
                  },
                  "channels": {
                    "type": "string",
                    "enum": ["rgba", "rgb", "alpha"],
                    "default": "rgba",
                    "description": "Output color channels. Use 'rgba' for transparency, 'rgb' for an opaque output (background filled with bg_color, white by default), or 'alpha' for the grayscale alpha mask only (for video: a grayscale matte video with no audio track)."
                  },
                  "bg_color": {
                    "type": "string",
                    "description": "Background color (hex, rgb, or color name) used whenever the output has no alpha channel: channels=rgb, format=jpg and format=mp4. Defaults to white. Ignored for transparent output and alpha masks.",
                    "example": "#ffffff"
                  },
                  "size": {
                    "type": "string",
                    "enum": ["full", "preview", "medium", "hd"],
                    "default": "full",
                    "description": "Output size preset (megapixel cap), for images and videos. For video the cap applies to every frame and full is additionally capped at 1080p (longest side 1920 px). For images, ignored when width or height is set. For remove.bg compatibility the aliases auto, 4k and 50MP (treated as full) and small and regular (treated as preview) are also accepted."
                  },
                  "crop": {
                    "oneOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "string",
                        "pattern": "^\\d+:\\d+$"
                      }
                    ],
                    "default": false,
                    "description": "Image only (400 validation_error when sent with a video). Crop the image to the subject bounds. Pass true/false or an aspect ratio like '1:1', '4:3', '16:9'."
                  },
                  "padding": {
                    "type": "string",
                    "description": "Image only (400 validation_error when sent with a video). Padding around the subject when crop is enabled, added to each side as a fraction (e.g. '0.1') or percentage (e.g. '10%') of the subject's size on that axis. Pass one value for both axes, or two comma-separated values as horizontal,vertical (e.g. '10%,7.5%' gives a canvas 120% of subject width and 115% of subject height). Default '10%'.",
                    "example": "10%"
                  },
                  "crop_margin": {
                    "type": "string",
                    "example": "10%",
                    "description": "Image only (400 validation_error when sent with a video). remove.bg-compatible alias for padding, using CSS margin shorthand with one to four space-separated values (e.g. '10%' or '0px 5%'). Percentages map onto padding; a zero pixel margin means a tight crop; other pixel margins cannot be honoured and are ignored. Ignored when padding is set."
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 6000,
                    "example": 500,
                    "description": "Image only (400 validation_error when sent with a video). Output width in pixels (1-6000). On its own, the height follows the image's aspect ratio. Together with height, the image is fitted into a width x height canvas according to fit. The aspect ratio is always preserved (never stretched); smaller images are upscaled unless fit is 'scale-down'. Overrides size."
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 6000,
                    "example": 500,
                    "description": "Image only (400 validation_error when sent with a video). Output height in pixels (1-6000). On its own, the width follows the image's aspect ratio. Together with width, the image is fitted into a width x height canvas according to fit. The aspect ratio is always preserved (never stretched); smaller images are upscaled unless fit is 'scale-down'. Overrides size."
                  },
                  "fit": {
                    "type": "string",
                    "enum": ["contain", "cover", "scale-down"],
                    "default": "contain",
                    "description": "Image only (400 validation_error when sent with a video). How to fit the image into width/height. 'contain' scales the image to fit inside and centres it, filling the remaining area with transparency (or bg_color). 'cover' scales the image to fill the canvas and crops the overflow, keeping the subject centred. 'scale-down' is like 'contain' but never enlarges: a smaller image keeps its native size (centred on the canvas when both dimensions are set). contain and cover only differ when both width and height are set."
                  }
                },
                "description": "Provide exactly one input: file (upload) or url (public https URL). The legacy names image_file, image_file_b64 and image_url are still accepted. If several are sent, file / image_file wins, then image_file_b64, then url / image_url. The media type is detected from the content; crop, padding, crop_margin, width, height and fit are image-only."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully processed image (image input only)",
            "headers": {
              "Content-Type": {
                "description": "MIME type of the returned image",
                "schema": {
                  "type": "string",
                  "example": "image/png"
                }
              },
              "X-Request-ID": {
                "description": "Unique request identifier for support",
                "schema": {
                  "type": "string",
                  "example": "req_abc123xyz"
                }
              },
              "X-Processing-Time-Ms": {
                "description": "Processing time in milliseconds",
                "schema": {
                  "type": "integer",
                  "example": 450
                }
              },
              "X-Image-Width": {
                "description": "Output image width in pixels",
                "schema": {
                  "type": "integer",
                  "example": 1920
                }
              },
              "X-Image-Height": {
                "description": "Output image height in pixels",
                "schema": {
                  "type": "integer",
                  "example": 1080
                }
              },
              "X-Matte-Confidence": {
                "description": "Heuristic confidence in the alpha matte, 0-1. Mean decisiveness of the mask: 1 means fully binary, lower values mean the model hedged. Not a calibrated probability.",
                "schema": {
                  "type": "number",
                  "example": 0.9732
                }
              },
              "X-Matte-Ambiguous-Ratio": {
                "description": "Fraction of pixels with alpha between 0.1 and 0.9, 0-1. High values indicate large uncertain regions; useful for flagging results for review.",
                "schema": {
                  "type": "number",
                  "example": 0.0427
                }
              }
            },
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/webp": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "202": {
            "description": "Video accepted (video input only). The video has been probed, credits have been charged and processing has been queued. Poll GET /jobs/{id}.",
            "headers": {
              "X-Request-ID": {
                "description": "Unique request identifier for support",
                "schema": {
                  "type": "string",
                  "example": "req_abc123xyz"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                },
                "example": {
                  "id": "job_8f3a1c2e9b7d4a10",
                  "status": "queued",
                  "progress": 0,
                  "created_at": "2026-10-12T10:12:00Z",
                  "started_at": null,
                  "completed_at": null,
                  "duration_seconds": 12.4,
                  "fps": 29.97,
                  "width": 1920,
                  "height": 1080,
                  "frames": 372,
                  "credits": 65,
                  "format": "webm",
                  "channels": "rgba",
                  "status_url": "https://api.poof.bg/v1/jobs/job_8f3a1c2e9b7d4a10",
                  "result_url": null,
                  "expires_at": null,
                  "error": null,
                  "stats": null
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "headers": {
              "X-Request-ID": {
                "description": "Unique request identifier, equal to request_id in the body. Include it when contacting support.",
                "schema": {
                  "type": "string",
                  "example": "req_3f6a2c1e-9b0d-4e7a-8c21-5d1f0a9b7e42"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "validation_error": {
                    "summary": "Validation Error",
                    "value": {
                      "code": "validation_error",
                      "message": "Invalid value for 'format': expected one of png, jpg, webp.",
                      "details": {
                        "format": ["must be one of: png, jpg, webp"]
                      },
                      "request_id": "req_3f6a2c1e-9b0d-4e7a-8c21-5d1f0a9b7e42",
                      "doc_url": "https://docs.poof.bg/errors/validation-error"
                    }
                  },
                  "missing_image": {
                    "summary": "Missing Image",
                    "value": {
                      "code": "missing_image",
                      "message": "No input provided. Send multipart/form-data with a 'file' part or a 'url' field.",
                      "request_id": "req_3f6a2c1e-9b0d-4e7a-8c21-5d1f0a9b7e42",
                      "doc_url": "https://docs.poof.bg/errors/missing-image"
                    }
