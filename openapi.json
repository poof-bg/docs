          },
          "401": {
            "description": "Unauthorized",
            "headers": {
              "X-Request-ID": {
                "description": "Unique request identifier, equal to request_id in the body. Include it when contacting support.",
                "schema": {
                  "type": "string",
                  "example": "req_3f6a2c1e-9b0d-4e7a-8c21-5d1f0a9b7e42"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
